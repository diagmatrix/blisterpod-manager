root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# Emitted by the shadcn CLI at 2 spaces; see the matching exclusion in eslint.config.js.
[src/renderer/src/components/ui/**.{ts,tsx}]
indent_size = 2

[*.{json,yml,yaml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
